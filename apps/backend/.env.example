# Database connection URL
DATABASE_URL=postgresql://username@127.0.0.1:5432/naru

# JWT secrets (change these in production!)
JWT_SECRET=<openssl rand -base64 48>
JWT_REFRESH_SECRET=<a second, different openssl rand -base64 48>

# Server port
PORT=3000

# AWS RDS IAM Authentication
USE_RDS_IAM=false
AWS_REGION=us-east-1

# File/photo storage driver: "s3" or "local".
# If unset: defaults to "local" in dev, "s3" when NODE_ENV=production.
# "local" stores uploads on disk under packages/backend/uploads/ and serves
# them through the backend — no AWS_S3_* vars needed.
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=uploads

# AWS S3 (photo uploads) — only required when STORAGE_DRIVER resolves to "s3"
STORAGE_DRIVER=s3
AWS_S3_BUCKET=name
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=unkown
AWS_SECRET_ACCESS_KEY=unkown
